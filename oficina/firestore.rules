rules_version = '2';
// Reglas de la base de datos de la oficina (Firebase › Firestore Database › Reglas).
// Solo entran los dos socios, con el correo confirmado. El robot es la cuenta con la que Claude
// lee y escribe para los correos diarios y para cargar información; no puede leer la Caja fuerte.
service cloud.firestore {
  match /databases/{database}/documents {
    function socio() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['CORREO_SIMON', 'CORREO_SEBASTIAN'];
    }
    function robot() {
      return request.auth != null && request.auth.token.email == 'CORREO_ROBOT';
    }
    // la caja: el robot solo deja datos nuevos (semilla) o crea la caja cifrada al migrar; nunca la lee
    match /caja/{id} {
      allow read, write: if socio();
      allow create: if robot() && (id == 'semilla' || id == 'fuerte');
      allow update, delete: if robot() && id == 'semilla';
    }
    match /{coleccion}/{id} {
      allow read, write: if socio() || (robot() && coleccion != 'caja');
    }
  }
}
